# =============================================
# One-API 生产环境配置文件
# =============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改标记为 [必须] 的配置项
# 3. 根据需要修改 [可选] 配置项
# =============================================

# =============================================
# [必须] 数据库配置
# =============================================
# MySQL 连接字符串（生产环境必须使用 MySQL/PostgreSQL）
# 格式：user:password@tcp(host:port)/dbname
SQL_DSN="oneapi:123456@tcp(mysql:3306)/one-api"

# [可选] SQLite 路径（仅开发环境使用，生产环境请注释）
# SQLITE_PATH="./one-api.db"

# =============================================
# [必须] 会话安全配置
# =============================================
# 会话密钥：必须修改为随机字符串（至少 32 字符）
# 生成命令：openssl rand -base64 32
# 多机部署时所有服务器必须使用相同的值
SESSION_SECRET="请修改为随机字符串_至少 32 字符"

# =============================================
# [推荐] Redis 缓存配置
# =============================================
# Redis 连接字符串（高并发环境推荐启用）
REDIS_CONN_STRING="redis://redis:6379"

# Redis 同步频率（秒）- 启用 Redis 时必须设置
SYNC_FREQUENCY=60

# [可选] Redis 密码（集群/哨兵模式）
# REDIS_PASSWORD=""

# [可选] Redis 主节点名称（哨兵模式）
# REDIS_MASTER_NAME="mymaster"

# =============================================
# [推荐] 性能优化配置
# =============================================
# 启用内存缓存
MEMORY_CACHE_ENABLED=true

# 启用数据库批量更新（减少连接数）
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5

# 数据库连接池配置
SQL_MAX_IDLE_CONNS=100
SQL_MAX_OPEN_CONNS=1000
SQL_CONN_MAX_LIFETIME=60

# =============================================
# [可选] 服务端口和时区
# =============================================
PORT=3000
TZ=Asia/Shanghai

# =============================================
# [可选] 主题配置
# =============================================
# 可选值：default, berry, air
THEME=default

# =============================================
# [可选] 渠道管理配置
# =============================================
# 渠道余额更新频率（分钟）
CHANNEL_UPDATE_FREQUENCY=1440

# 渠道测试频率（分钟）
CHANNEL_TEST_FREQUENCY=1440

# 批量操作间隔（秒）
POLLING_INTERVAL=5

# =============================================
# [可选] 速率限制配置
# =============================================
# API 请求限制：单 IP 每 3 分钟最大请求数
GLOBAL_API_RATE_LIMIT=480

# Web 请求限制：单 IP 每 3 分钟最大请求数
GLOBAL_WEB_RATE_LIMIT=240

# =============================================
# [可选] 多机部署配置
# =============================================
# 主节点配置（默认）
# NODE_TYPE=master

# 从节点配置（取消注释以启用）
# NODE_TYPE=slave
# FRONTEND_BASE_URL=https://master.example.com

# =============================================
# [可选] 邮件服务配置（用于邮箱验证）
# =============================================
# SMTP_SERVER="smtp.example.com"
# SMTP_PORT=587
# SMTP_ACCOUNT="noreply@example.com"
# SMTP_FROM="One API <noreply@example.com>"
# SMTPToken="your_smtp_password"

# =============================================
# [可选] OAuth 登录配置
# =============================================
# GitHub OAuth
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# 飞书 OAuth
# LARK_CLIENT_ID=""
# LARK_CLIENT_SECRET=""

# =============================================
# [可选] 安全防护配置
# =============================================
# Cloudflare Turnstile（防机器人）
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# =============================================
# [可选] 日志和调试配置
# =============================================
# 调试模式（生产环境请设为 false）
DEBUG=false

# SQL 日志（开发环境使用）
# DEBUG_SQL=false

# 日志目录
LOG_DIR="./logs"

# =============================================
# [可选] Token 编码器缓存（离线环境）
# =============================================
# TIKTOKEN_CACHE_DIR="./tiktoken_cache"
# DATA_GYM_CACHE_DIR="./data_gym_cache"

# =============================================
# [可选] 初始化令牌（首次启动）
# =============================================
# 自动创建 root 用户令牌
# INITIAL_ROOT_TOKEN=""

# 自动创建 root 访问令牌
# INITIAL_ROOT_ACCESS_TOKEN=""
